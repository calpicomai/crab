# Optional stationary companion service; installation itself requires approval.
# Edit User and paths before deployment. brain/run.sh preserves crab.env, starts
# no heavy model/service automatically, and never changes Jetson power mode.
# Run `bash brain/run.sh check` and complete docs/HARDWARE_ACCEPTANCE.md first.
# Existing calibration, memory and configuration must be backed up before deployment.

[Unit]
Description=PiCrawler pet (Jetson brain)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=orin
WorkingDirectory=/home/orin/crab
ExecStart=/bin/bash /home/orin/crab/brain/run.sh pet
Restart=always
RestartSec=8

[Install]
WantedBy=multi-user.target
